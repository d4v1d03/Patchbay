# ---- LLM (any OpenAI-compatible provider) ----
# DeepSeek:   https://api.deepseek.com                              deepseek-flash
# Qwen:       https://dashscope-intl.aliyuncs.com/compatible-mode/v1  qwen3-coder-plus
# Kimi:       https://api.moonshot.ai/v1                            kimi-k2-<latest>
# GLM:        https://api.z.ai/api/paas/v4                          glm-4.6
# OpenRouter: https://openrouter.ai/api/v1                          qwen/qwen3-coder
LLM_BASE_URL=https://api.deepseek.com   # or `fake` for the scripted demo model (no key needed)
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_THINKING=off                 # off | low | high | max; empty = the provider's default (see docs/EVALS.md)
PROMPT_VERSION=v2                # system prompt version (agent/prompts/system_v*.md)

# ---- Public deployment (docker-compose.prod.yml; see deploy/README.md) ----
# PATCHBAY_DOMAIN=yourname.duckdns.org
# ACME_EMAIL=you@example.com         # Let's Encrypt expiry notices
# PATCHBAY_AUTH is written by deploy/make-login.sh

# ---- Infrastructure ----
TRAEFIK_PORT=8088               # host port for the compose stack (80 if it's free on your machine)
TRAEFIK_DASHBOARD_PORT=8090
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///data/patchbay.db

# ---- Sandbox ----
SANDBOX_IMAGE=patchbay-sandbox:latest
SANDBOX_NETWORK=bridge          # or "none" to cut the agent off from the internet
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_TTL_MINUTES=60          # idle sandboxes older than this are removed by the reaper
MAINTENANCE_INTERVAL_S=300

# ---- Agent limits ----
MAX_STEPS=40
CONTEXT_BUDGET_TOKENS=0          # compact old tool outputs past this many tokens; 0 = off (see docs/EVALS.md)
VERIFY_ROUNDS=0                  # review each finish with a second model call, rejecting at most N times; 0 = off
MAX_SESSION_TOKENS=400000        # tokens a session may spend across runs (cached count a tenth); 0 = unlimited
MAX_TOOL_OUTPUT_CHARS=8000
DEFAULT_TOOL_TIMEOUT_S=120
MAX_TOOL_TIMEOUT_S=600
